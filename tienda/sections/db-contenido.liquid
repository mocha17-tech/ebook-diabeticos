{{ 'db-styles.css' | asset_url | stylesheet_tag }}

{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .db-contenido {
    background-color: {{ section.settings.color_fondo }};
  }
  #shopify-section-{{ section.id }} .db-contenido__titulo {
    font-size: {{ section.settings.titulo_size }}px;
  }
{% endstyle %}

<div class="db-contenido">
  <div class="db-container">

    <div class="db-contenido__header db-reveal">
      {%- if section.settings.eyebrow != blank -%}
        <span class="db-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 class="db-titulo db-contenido__titulo">{{ section.settings.titulo }}</h2>
      {%- if section.settings.descripcion != blank -%}
        <p class="db-contenido__descripcion">{{ section.settings.descripcion | newline_to_br }}</p>
      {%- endif -%}
    </div>

    <div class="db-contenido__grid">
      {%- for block in section.blocks -%}
        <div class="db-receta-card db-reveal db-reveal--delay-{{ forloop.index }}" {{ block.shopify_attributes }}>
          {%- if block.settings.imagen != blank -%}
            <img class="db-receta-card__img"
                 src="{{ block.settings.imagen | image_url: width: 600 }}"
                 alt="{{ block.settings.nombre | escape }}"
                 loading="lazy">
          {%- else -%}
            <div class="db-receta-card__img-placeholder">{{ block.settings.icono | default: '🍰' }}</div>
          {%- endif -%}
          <div class="db-receta-card__body">
            <p class="db-receta-card__nombre">{{ block.settings.nombre }}</p>
            {%- if block.settings.tag != blank -%}
              <p class="db-receta-card__tag">{{ block.settings.tag }}</p>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>

    <div class="db-contenido__cta db-reveal">
      {%- if section.settings.btn_texto != blank -%}
        <a href="{{ section.settings.btn_url | default: '#' }}" class="db-btn db-btn--primario">
          {{ section.settings.btn_texto }}
        </a>
      {%- endif -%}
      {%- if section.settings.nota != blank -%}
        <p class="db-contenido__mas">{{ section.settings.nota }}</p>
      {%- endif -%}
    </div>

  </div>
</div>

<script src="{{ 'db-scripts.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "DB – Recetas preview",
  "tag": "section",
  "blocks": [
    {
      "type": "receta",
      "name": "Receta",
      "settings": [
        { "type": "image_picker", "id": "imagen", "label": "Foto de la receta" },
        { "type": "text", "id": "icono", "label": "Emoji si no hay foto", "default": "🍰" },
        { "type": "text", "id": "nombre", "label": "Nombre de la receta", "default": "Tarta de Fresas Sin Azúcar" },
        { "type": "text", "id": "tag", "label": "Etiqueta (ej: Sin gluten, Fácil)", "default": "Sin azúcar · Fácil" }
      ]
    }
  ],
  "settings": [
    { "type": "header", "content": "Encabezado" },
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño encima del título", "default": "Adelanto exclusivo" },
    { "type": "text", "id": "titulo", "label": "Título de la sección", "default": "Una muestra de lo que te espera" },
    { "type": "textarea", "id": "descripcion", "label": "Descripción", "default": "Solo algunos de los 50 postres que encontrarás dentro. Cada receta con foto, ingredientes exactos y pasos claros." },
    { "type": "header", "content": "Botón de compra" },
    { "type": "text", "id": "btn_texto", "label": "Texto del botón", "default": "Quiero las 50 recetas →" },
    { "type": "url", "id": "btn_url", "label": "Enlace del botón" },
    { "type": "text", "id": "nota", "label": "Nota debajo del botón", "default": "+ 46 recetas más te esperan adentro" },
    { "type": "header", "content": "Diseño" },
    { "type": "color", "id": "color_fondo", "label": "Color de fondo", "default": "#F5F0E5" },
    { "type": "range", "id": "titulo_size", "label": "Tamaño del título (px)", "min": 24, "max": 60, "step": 2, "unit": "px", "default": 40 },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 88 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 88 }
  ],
  "presets": [{
    "name": "DB – Recetas preview",
    "blocks": [
      { "type": "receta", "settings": { "icono": "🍓", "nombre": "Tarta de Fresas Sin Azúcar", "tag": "Sin azúcar · Fácil" } },
      { "type": "receta", "settings": { "icono": "🍫", "nombre": "Brownies de Chocolate Negro", "tag": "Sin gluten · Irresistible" } },
      { "type": "receta", "settings": { "icono": "🧁", "nombre": "Muffins de Arándanos", "tag": "Alta fibra · Rápido" } },
      { "type": "receta", "settings": { "icono": "🍮", "nombre": "Flan Casero con Stevia", "tag": "Clásico · 20 min" } }
    ]
  }]
}
{% endschema %}
