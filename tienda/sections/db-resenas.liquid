{{ 'db-styles.css' | asset_url | stylesheet_tag }}

{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .db-resenas {
    background-color: {{ section.settings.color_fondo }};
  }
  #shopify-section-{{ section.id }} .db-resenas__titulo {
    font-size: {{ section.settings.titulo_size }}px;
  }
{% endstyle %}

<div class="db-resenas">
  <div class="db-container">

    <div class="db-resenas__header db-reveal">
      {%- if section.settings.eyebrow != blank -%}
        <span class="db-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 class="db-titulo db-resenas__titulo">{{ section.settings.titulo }}</h2>
      <div class="db-resenas__estrellas-global">★★★★★</div>
    </div>

    <div class="db-resenas__grid">
      {%- for block in section.blocks -%}
        <div class="db-resena-card db-reveal db-reveal--delay-{{ forloop.index }}" {{ block.shopify_attributes }}>
          <div class="db-resena-card__estrellas">
            {%- assign estrellas = block.settings.estrellas | plus: 0 -%}
            {%- for i in (1..estrellas) -%}★{%- endfor -%}
          </div>
          <p class="db-resena-card__texto">"{{ block.settings.texto | newline_to_br }}"</p>
          <div class="db-resena-card__autor">
            <div class="db-resena-card__avatar">{{ block.settings.nombre | slice: 0 }}</div>
            <div>
              <p class="db-resena-card__nombre">{{ block.settings.nombre }}</p>
              <p class="db-resena-card__detalle">{{ block.settings.detalle }}</p>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>

  </div>
</div>

<script src="{{ 'db-scripts.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "DB – Reseñas",
  "tag": "section",
  "blocks": [
    {
      "type": "resena",
      "name": "Reseña",
      "settings": [
        { "type": "range", "id": "estrellas", "label": "Estrellas", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "texto", "label": "Texto de la reseña", "default": "Jamás pensé que podría disfrutar los postres como antes de que me diagnosticaran diabetes. Este libro cambió todo." },
        { "type": "text", "id": "nombre", "label": "Nombre de la persona", "default": "María García" },
        { "type": "text", "id": "detalle", "label": "Detalle (ej: Diabética tipo 2)", "default": "Diabética tipo 2 · Buenos Aires" }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño encima del título", "default": "Lo que dicen nuestras lectoras" },
    { "type": "text", "id": "titulo", "label": "Título de la sección", "default": "Más de 500 familias ya cocinan con Dulce Balance" },
    { "type": "color", "id": "color_fondo", "label": "Color de fondo", "default": "#F5F0E5" },
    { "type": "range", "id": "titulo_size", "label": "Tamaño del título (px)", "min": 24, "max": 60, "step": 2, "unit": "px", "default": 40 },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 88 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 88 }
  ],
  "presets": [{
    "name": "DB – Reseñas",
    "blocks": [
      { "type": "resena", "settings": { "estrellas": 5, "texto": "Jamás pensé que podría disfrutar los postres como antes de que me diagnosticaran diabetes. Este libro cambió todo. La tarta de fresas la hago cada fin de semana.", "nombre": "María García", "detalle": "Diabética tipo 2 · Buenos Aires" } },
      { "type": "resena", "settings": { "estrellas": 5, "texto": "Lo compré para mi mamá y terminamos cocinando juntas cada domingo. Las recetas son facilísimas y los ingredientes se consiguen en cualquier super.", "nombre": "Carolina López", "detalle": "Hija de diabética · Córdoba" } },
      { "type": "resena", "settings": { "estrellas": 5, "texto": "Como médico, me alegra ver un ebook con el respaldo de la SAD. Las recetas son nutricionalmente sólidas y además están buenísimas. Lo recomiendo a mis pacientes.", "nombre": "Dr. Roberto Sanz", "detalle": "Médico especialista · Rosario" } }
    ]
  }]
}
{% endschema %}
