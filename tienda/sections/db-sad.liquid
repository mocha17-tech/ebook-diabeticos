{{ 'db-styles.css' | asset_url | stylesheet_tag }}

{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .db-sad {
    background-color: {{ section.settings.color_fondo }};
  }
  #shopify-section-{{ section.id }} .db-sad__titulo {
    font-size: {{ section.settings.titulo_size }}px;
  }
{% endstyle %}

<div class="db-sad">
  <div class="db-container">
    <div class="db-sad__inner db-reveal">

      <div class="db-sad__sello-wrap">
        {%- if section.settings.imagen_sello != blank -%}
          <img class="db-sad__sello-img"
               src="{{ section.settings.imagen_sello | image_url: width: 300 }}"
               alt="Sello de la Sociedad Argentina de Diabetes"
               loading="lazy">
        {%- else -%}
          <div class="db-sad__sello-placeholder">
            <span class="db-sad__sello-icono">🏅</span>
            <span class="db-sad__sello-texto-badge">SAD</span>
          </div>
        {%- endif -%}
      </div>

      <div class="db-sad__contenido">
        {%- if section.settings.eyebrow != blank -%}
          <span class="db-eyebrow db-sad__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}

        <h2 class="db-titulo db-sad__titulo">{{ section.settings.titulo }}</h2>

        {%- if section.settings.descripcion != blank -%}
          <p class="db-sad__descripcion">{{ section.settings.descripcion | newline_to_br }}</p>
        {%- endif -%}

        <div class="db-sad__puntos">
          {%- for block in section.blocks -%}
            <div class="db-sad__punto" {{ block.shopify_attributes }}>
              <span class="db-sad__punto-icono">✓</span>
              <span class="db-sad__punto-texto">{{ block.settings.texto }}</span>
            </div>
          {%- endfor -%}
        </div>
      </div>

    </div>
  </div>
</div>

<script src="{{ 'db-scripts.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "DB – Aval SAD",
  "tag": "section",
  "blocks": [
    {
      "type": "punto",
      "name": "Punto de confianza",
      "settings": [
        { "type": "text", "id": "texto", "label": "Texto del punto", "default": "Recetas revisadas por especialistas en diabetes" }
      ]
    }
  ],
  "settings": [
    { "type": "header", "content": "Textos" },
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño encima del título", "default": "Respaldo científico" },
    { "type": "text", "id": "titulo", "label": "Título", "default": "Avalado por la Sociedad Argentina de Diabetes" },
    { "type": "textarea", "id": "descripcion", "label": "Descripción", "default": "Cada receta de Dulce Balance fue revisada y aprobada por la SAD, asegurando que sea segura, equilibrada y apta para personas con diabetes tipo 1 y tipo 2." },
    { "type": "header", "content": "Imagen del sello" },
    { "type": "image_picker", "id": "imagen_sello", "label": "Imagen del sello SAD (subí el logo o sello oficial)" },
    { "type": "header", "content": "Diseño" },
    { "type": "color", "id": "color_fondo", "label": "Color de fondo", "default": "#F5F0E5" },
    { "type": "range", "id": "titulo_size", "label": "Tamaño del título (px)", "min": 24, "max": 56, "step": 2, "unit": "px", "default": 36 },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 88 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 88 }
  ],
  "presets": [{
    "name": "DB – Aval SAD",
    "blocks": [
      { "type": "punto", "settings": { "texto": "Recetas revisadas por especialistas en diabetes" } },
      { "type": "punto", "settings": { "texto": "Índice glucémico controlado en cada ingrediente" } },
      { "type": "punto", "settings": { "texto": "Coherente con las guías nutricionales de la SAD" } },
      { "type": "punto", "settings": { "texto": "Apto para diabetes tipo 1 y tipo 2" } }
    ]
  }]
}
{% endschema %}
